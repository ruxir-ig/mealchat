# mealchat configuration — copy to .env and fill in.
# Both models go through one OpenAI-compatible API. Defaults are plain public
# OpenAI models, so a fresh clone runs with just an OpenAI key; point the
# base/model names at any other OpenAI-compatible provider if you prefer.

# Any OpenAI-compatible base URL (https://api.openai.com/v1, Fireworks,
# Together, a local vLLM, …)
MEALCHAT_API_BASE=https://api.openai.com/v1
MEALCHAT_API_KEY=sk-...

# Text/conversation model — needs function/tool calling.
MEALCHAT_TEXT_MODEL=gpt-4o-mini

# Vision model — must accept image input and must be a DIFFERENT model.
MEALCHAT_VISION_MODEL=gpt-4o

# Optional: reasoning effort for models that support it (empty = not sent,
# which is right for most chat-completions models — they reject the param).
MEALCHAT_TEXT_REASONING=
MEALCHAT_VISION_REASONING=

# Hard time budget (seconds) for one vision call. On timeout the agent
# degrades to the uncertain path and asks the user instead of waiting.
MEALCHAT_VISION_TIMEOUT=20

# Optional: route vision through a different gateway/key
# MEALCHAT_VISION_API_BASE=
# MEALCHAT_VISION_API_KEY=

# Local date used for "today" boundaries (IANA name)
MEALCHAT_TIMEZONE=Asia/Kolkata

# SQLite database file
MEALCHAT_DB=data/mealchat.db
