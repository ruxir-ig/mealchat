# mealchat configuration — copy to .env and fill in.
# Both models below run through one OpenAI-compatible gateway by default.

# Any OpenAI-compatible base URL
MEALCHAT_API_BASE=https://code.in2peta.com/v1
MEALCHAT_API_KEY=your-key-here

# Text/conversation model (tool calling). Text-only is fine.
MEALCHAT_TEXT_MODEL=deepseek-v4p1-flash
MEALCHAT_TEXT_REASONING=low

# Vision model (must accept image input). Must be a DIFFERENT model.
MEALCHAT_VISION_MODEL=glm-5.3-flash
MEALCHAT_VISION_REASONING=low

# Optional: route vision through a different gateway/key
# MEALCHAT_VISION_API_BASE=
# MEALCHAT_VISION_API_KEY=

# Local date used for "today" boundaries (IANA name)
MEALCHAT_TIMEZONE=Asia/Kolkata

# SQLite database file
MEALCHAT_DB=data/mealchat.db
